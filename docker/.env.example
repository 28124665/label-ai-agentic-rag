# Database Configuration
DB_TYPE=postgres

# PostgreSQL Configuration (docker-compose postgres service)
POSTGRES_DB=rag_flow
POSTGRES_USER=rag_flow
POSTGRES_PASSWORD=infini_rag_flow
EXPOSE_POSTGRES_PORT=5432

# service_conf.yaml.template → conf/service_conf.yaml（容器 entrypoint 展开 ${VAR:-default}）
# 主库 postgresql 段（RDS / 外部 PG；与 conf/service_conf.yaml 中 postgresql: 对应）
POSTGRESQL_HOST=postgres
POSTGRESQL_PORT=5432
POSTGRESQL_DBNAME=rag_flow
POSTGRESQL_USER=rag_flow
POSTGRESQL_PASSWORD=change_me
POSTGRESQL_MAX_CONNECTIONS=100
POSTGRESQL_STALE_TIMEOUT=30
# 可选：Peewee 用 postgres 段（本地 docker 内服务名常为 postgres）
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DBNAME=rag_flow
# POSTGRES_USER=rag_flow
# POSTGRES_PASSWORD=infini_rag_flow

# OSS（与 conf/service_conf.yaml 中 oss: 对应；勿提交真实 AK/SK）
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_ENDPOINT_URL=
OSS_REGION=
OSS_BUCKET=
OSS_SIGNATURE_VERSION=s3
OSS_ADDRESSING_STYLE=virtual
OSS_PREFIX_PATH=

# TEI 嵌入服务主机名（compose 网络内常为 tei）
TEI_HOST=tei

# MySQL Configuration (for reference)
MYSQL_PASSWORD=infini_rag_flow
EXPOSE_MYSQL_PORT=5455

# Redis Configuration
REDIS_PASSWORD=infini_rag_flow
REDIS_PORT=6379

# MinIO Configuration
MINIO_USER=rag_flow
MINIO_PASSWORD=infini_rag_flow
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Elasticsearch Configuration
ELASTIC_PASSWORD=infini_rag_flow
ES_PORT=1200

# OpenSearch Configuration
OPENSEARCH_PASSWORD=infini_rag_flow_OS_01
OS_PORT=1201

# Infinity Configuration
INFINITY_THRIFT_PORT=23817
INFINITY_HTTP_PORT=23820
INFINITY_PSQL_PORT=5432

# OceanBase Configuration
OB_TENANT_NAME=ragflow
OB_TENANT_PASSWORD=infini_rag_flow
OCEANBASE_PORT=2881
OCEANBASE_DOC_DBNAME=ragflow_doc

# SeekDB Configuration
SEEKDB_PASSWORD=infini_rag_flow
SEEKDB_PORT=2881
SEEKDB_DOC_DBNAME=ragflow_doc

# TEI Configuration
TEI_PORT=6380
TEI_MODEL=BAAI/bge-small-en-v1.5
TEI_IMAGE_CPU=infiniflow/tei:cpu
TEI_IMAGE_GPU=infiniflow/tei:gpu

# Sandbox Configuration
SANDBOX_ENABLED=0
SANDBOX_EXECUTOR_MANAGER_PORT=9385
SANDBOX_EXECUTOR_MANAGER_POOL_SIZE=3
SANDBOX_BASE_PYTHON_IMAGE=infiniflow/sandbox-base-python:latest
SANDBOX_BASE_NODEJS_IMAGE=infiniflow/sandbox-base-nodejs:latest
SANDBOX_ENABLE_SECCOMP=false
SANDBOX_MAX_MEMORY=256m
SANDBOX_TIMEOUT=10s

# Kibana Configuration
KIBANA_PORT=5601

# Stack Version
STACK_VERSION=8.13.0

# Memory Limit
MEM_LIMIT=4g

# Storage Implementation
# STORAGE_IMPL=MINIO
STORAGE_IMPL=OSS

# Registration Enabled
REGISTER_ENABLED=1

# Disable Password Login
DISABLE_PASSWORD_LOGIN=false

# RAGFlow Crypto Enabled
RAGFLOW_CRYPTO_ENABLED=false
RAGFLOW_CRYPTO_ALGORITHM=aes-256-cbc
RAGFLOW_CRYPTO_KEY=

# Dotnet System Globalization Invariant
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

# Document Configuration
MAX_CONTENT_LENGTH=134217728
DOC_BULK_SIZE=4
EMBEDDING_BATCH_SIZE=16

# Compose Profiles
COMPOSE_PROFILES=postgres

# 文档引擎: elasticsearch, infinity, oceanbase, postgresql
DOC_ENGINE=postgresql

# 应用镜像（本地 build 后的 tag；Docker Hub 上无此仓库，勿指望 pull）
# 首次启动请用: docker compose --profile postgres --profile cpu up --build -d
RAGFLOW_IMAGE=data-knowledge-api:latest

# Dockerfile 构建阶段从该镜像 COPY tika/deepdoc 模型等。Docker Hub 超时可改为华为云镜像或本地先构建 Dockerfile.deps：
# docker build -f Dockerfile.deps -t infiniflow/ragflow_deps:latest ..  （在仓库根目录，且已 uv run download_deps.py）
# RAGFLOW_DEPS_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/infiniflow/ragflow_deps:latest
RAGFLOW_DEPS_IMAGE=infiniflow/ragflow_deps:latest
# 国内构建可加速 apt/pypi/git 等（Dockerfile 内 NEED_MIRROR=1）
NEED_MIRROR=1

# 基础镜像（Hub 超时可改用华为 SWR 的 docker.io 缓存，与 RAGFLOW_DEPS_IMAGE 同源）
# DOCKER_BASE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/ubuntu:24.04
DOCKER_BASE_IMAGE=ubuntu:24.04

# Web / API 端口（与 docker-compose.yml 一致）
SVR_WEB_HTTP_PORT=80
SVR_WEB_HTTPS_PORT=443
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382