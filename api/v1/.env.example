# Local dev .env template for api/v1 (FastAPI)
# 复制为 .env 并按需填写；.env 已被 .gitignore 忽略，禁止提交真实凭证。
# 安全说明：DEBUG=true 时不强制要求 JWT_SECRET_KEY，但生产必须设置强随机值。
APP_NAME=Agentic RAG API
APP_VERSION=1.0.0
DEBUG=true

HOST=0.0.0.0
PORT=8000

# PostgreSQL（基础设施未启动时会连不上，但 API 进程本身能起）
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentic_rag

# Redis
REDIS_URL=redis://localhost:6379/0

# RAGFlow 原生后端（如果未启动，相关功能会失败）
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=

# JWT（dev 环境可以留空，DEBUG=true 不强制校验；生产必须设置）
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

LOG_LEVEL=INFO
