# data-knowledge-api 生产镜像（Honghai 变体）
#
# 相对旧版的主要优化：
# - 多阶段：运行时镜像不再包含 Node.js、Rust/cargo、build-essential、libpython3-dev（仅 builder 阶段）
# - apt：统一使用 --no-install-recommends；Java 用 default-jre-headless；去掉 vim/less/wget/git（git 仅在 builder）
# - PDF：pypandoc 需要 LaTeX 时用 texlive-latex-base + fonts-recommended，替代完整 texlive（体积显著减小）
# - MSSQL ODBC：可选 INSTALL_MSODBCSQL=0 跳过以进一步瘦身
# - Ubuntu 24.04 (noble) 使用 Microsoft 仓库 noble 配置，替代错误的 22.04 源
# - 前端构建不再 COPY docs（与 web 构建无关）
#
# Deps：`FROM ${DEPS_IMAGE}` 由本机 Docker 拉取。若 auth.docker.io 超时，见下方 DEPS_IMAGE / BASE_IMAGE 说明。
#
ARG DEPS_IMAGE=infiniflow/ragflow_deps:latest
ARG BASE_IMAGE=ubuntu:24.04

FROM ${DEPS_IMAGE} AS deps

# -----------------------------------------------------------------------------
# base-runtime：运行期依赖（被 production 使用；无编译链、无 Node、无 Rust）
# -----------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS base-runtime
USER root
SHELL ["/bin/bash", "-c"]

ARG NEED_MIRROR=0
ARG INSTALL_MSODBCSQL=1

WORKDIR /data-knowledge-api

RUN mkdir -p /data-knowledge-api/rag/res/deepdoc /root/.data-knowledge-api
RUN --mount=type=bind,from=deps,source=/huggingface.co,target=/huggingface.co \
    tar --exclude='.*' -cf - \
        /huggingface.co/InfiniFlow/text_concat_xgb_v1.0 \
        /huggingface.co/InfiniFlow/deepdoc \
        | tar -xf - --strip-components=3 -C /data-knowledge-api/rag/res/deepdoc

RUN --mount=type=bind,from=deps,source=/,target=/deps \
    cp -r /deps/nltk_data /root/ && \
    TIKA_JAR=$(find /deps -type f -name 'tika-server-standard-*.jar' ! -name '*.md5' | head -1) && \
    test -n "$TIKA_JAR" || (echo "No tika-server-standard-*.jar under /deps:"; ls -laR /deps | head -80; exit 1) && \
    TIKA_BASE=$(basename "$TIKA_JAR") && \
    TIKA_DIR=$(dirname "$TIKA_JAR") && \
    cp "$TIKA_JAR" /data-knowledge-api/ && \
    if [ -f "$TIKA_DIR/$TIKA_BASE.md5" ]; then cp "$TIKA_DIR/$TIKA_BASE.md5" /data-knowledge-api/; fi && \
    ln -sf "$TIKA_BASE" /data-knowledge-api/tika-server-standard.jar && \
    cp /deps/cl100k_base.tiktoken /data-knowledge-api/9b5ad71b2ce5302211f9c61530b329a4922fc6a4

ENV TIKA_SERVER_JAR="file:///data-knowledge-api/tika-server-standard.jar"
ENV DEBIAN_FRONTEND=noninteractive

# 运行期：OpenCV / Chrome(headless) / Tika(Java) / pypandoc+简易 LaTeX(PDF) / ghostscript(PDF 修复) / psql(Infinity 查询) / jemalloc(entrypoint)
RUN --mount=type=cache,id=data-knowledge-api_apt,target=/var/cache/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg unzip && \
    if [ "$NEED_MIRROR" = "1" ]; then \
        sed -i 's|http://archive.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources; \
        sed -i 's|http://security.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources; \
    fi && \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache && \
    chmod 1777 /tmp && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libglib2.0-0 libglx-mesa0 libgl1 \
        pkg-config libicu74 libgdiplus \
        default-jre-headless \
        libatk-bridge2.0-0 libnss3 libgbm1 libgtk-4-1 xdg-utils \
        libjemalloc-dev \
        ghostscript \
        pandoc texlive-latex-base texlive-fonts-recommended \
        fonts-freefont-ttf fonts-noto-cjk \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# 仅在此层临时安装 git，完成后卸载，避免运行镜像长期携带 git
RUN apt-get update && apt-get install -y --no-install-recommends git && \
    mkdir -p /usr/share/infinity/resource && \
    if [ "$NEED_MIRROR" = "1" ]; then \
        git clone --depth 1 --single-branch https://gitee.com/infiniflow/resource /tmp/resource; \
    else \
        git clone --depth 1 --single-branch https://github.com/infiniflow/resource.git /tmp/resource; \
    fi && \
    cp -r /tmp/resource/* /usr/share/infinity/resource && \
    rm -rf /tmp/resource && \
    apt-get purge -y git && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

ARG NGINX_VERSION=1.29.5-1~noble
RUN --mount=type=cache,id=data-knowledge-api_apt,target=/var/cache/apt,sharing=locked \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://nginx.org/keys/nginx_signing.key | gpg --dearmor -o /etc/apt/keyrings/nginx-archive-keyring.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/mainline/ubuntu/ noble nginx" > /etc/apt/sources.list.d/nginx.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends nginx=${NGINX_VERSION} && \
    apt-mark hold nginx && \
    rm -f /etc/nginx/conf.d/default.conf && \
    rm -rf /var/lib/apt/lists/*

ARG UV_VERSION=0.9.16
RUN --mount=type=bind,from=deps,source=/,target=/deps \
    if [ "$NEED_MIRROR" = "1" ]; then \
        mkdir -p /etc/uv && \
        echo 'python-install-mirror = "https://registry.npmmirror.com/-/binary/python-build-standalone/"' > /etc/uv/uv.toml && \
        echo '[[index]]' >> /etc/uv/uv.toml && \
        echo 'url = "https://pypi.tuna.tsinghua.edu.cn/simple"' >> /etc/uv/uv.toml && \
        echo 'default = true' >> /etc/uv/uv.toml; \
    fi; \
    arch="$(uname -m)"; \
    if [ "$arch" = "x86_64" ]; then uv_arch="x86_64"; else uv_arch="aarch64"; fi; \
    UV_TGZ=$(find /deps -type f -name "uv-${uv_arch}-unknown-linux-*.tar.gz" 2>/dev/null | head -1); \
    if [ -z "$UV_TGZ" ] || [ ! -f "$UV_TGZ" ]; then UV_TGZ="/deps/uv-${uv_arch}-unknown-linux-gnu.tar.gz"; fi; \
    if [ ! -f "$UV_TGZ" ]; then \
        UV_URL="https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${uv_arch}-unknown-linux-gnu.tar.gz"; \
        echo "uv tarball not in deps image; downloading ${UV_URL}"; \
        curl -fsSL "$UV_URL" -o /tmp/uv-dist.tar.gz; \
        UV_TGZ=/tmp/uv-dist.tar.gz; \
    fi; \
    UV_DIR=$(tar tzf "$UV_TGZ" | head -1 | cut -d/ -f1) && \
    tar xzf "$UV_TGZ" && \
    cp "${UV_DIR}/"* /usr/local/bin/ && \
    rm -rf "${UV_DIR}" && \
    rm -f /tmp/uv-dist.tar.gz && \
    uv python install 3.12

ENV PYTHONDONTWRITEBYTECODE=1 DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
ENV PATH=/root/.local/bin:$PATH

# Microsoft ODBC（Ubuntu 24.04 源仅提供 msodbcsql18，无 msodbcsql17；应用层使用 ODBC Driver 18）
# 不需要 MSSQL 时：INSTALL_MSODBCSQL=0
RUN --mount=type=cache,id=data-knowledge-api_apt,target=/var/cache/apt,sharing=locked \
    if [ "$INSTALL_MSODBCSQL" = "1" ]; then \
        mkdir -p /etc/apt/keyrings && \
        curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /etc/apt/keyrings/microsoft-prod.gpg && \
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/ubuntu/24.04/prod noble main" \
            > /etc/apt/sources.list.d/microsoft-prod.list && \
        apt-get update && \
        ACCEPT_EULA=Y apt-get install -y --no-install-recommends unixodbc msodbcsql18 && \
        rm -rf /var/lib/apt/lists/*; \
    else \
        echo "Skipping MS ODBC (INSTALL_MSODBCSQL=0)"; \
    fi

RUN --mount=type=bind,from=deps,source=/chrome-linux64-121-0-6167-85,target=/chrome-linux64.zip \
    unzip /chrome-linux64.zip && \
    mv chrome-linux64 /opt/chrome && \
    ln -sf /opt/chrome/chrome /usr/local/bin/chrome && \
    ln -sf /opt/chrome/chrome /usr/local/bin/google-chrome
RUN --mount=type=bind,from=deps,source=/chromedriver-linux64-121-0-6167-85,target=/chromedriver-linux64.zip \
    unzip -j /chromedriver-linux64.zip chromedriver-linux64/chromedriver && \
    mv chromedriver /usr/local/bin/ && \
    rm -f /usr/bin/google-chrome 2>/dev/null || true

RUN --mount=type=bind,from=deps,source=/,target=/deps \
    if [ "$(uname -m)" = "x86_64" ]; then \
        dpkg -i /deps/libssl1.1_1.1.1f-1ubuntu2_amd64.deb; \
    elif [ "$(uname -m)" = "aarch64" ]; then \
        dpkg -i /deps/libssl1.1_1.1.1f-1ubuntu2_arm64.deb; \
    fi

# -----------------------------------------------------------------------------
# base-builder：在 runtime 之上增加编译与前端构建依赖
# -----------------------------------------------------------------------------
FROM base-runtime AS base-builder
ARG NEED_MIRROR=0

RUN --mount=type=cache,id=data-knowledge-api_apt,target=/var/cache/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        libpython3-dev \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,id=data-knowledge-api_apt,target=/var/cache/apt,sharing=locked \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get purge -y nodejs npm 2>/dev/null || true && \
    apt-get autoremove -y && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

RUN if [ "$NEED_MIRROR" = "1" ]; then \
         export RUSTUP_DIST_SERVER="https://mirrors.tuna.tsinghua.edu.cn/rustup"; \
         export RUSTUP_UPDATE_ROOT="https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup"; \
       fi \
    && curl --proto '=https' --tlsv1.2 --http1.1 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal

ENV PATH="/root/.cargo/bin:${PATH}"

RUN cargo --version && rustc --version

# -----------------------------------------------------------------------------
# builder
# -----------------------------------------------------------------------------
FROM base-builder AS builder
USER root
ARG NEED_MIRROR=0

WORKDIR /data-knowledge-api

COPY pyproject.toml uv.lock ./

RUN --mount=type=cache,id=data-knowledge-api_uv,target=/root/.cache/uv,sharing=locked \
    if [ "$NEED_MIRROR" = "1" ]; then \
        sed -i 's|pypi.org|pypi.tuna.tsinghua.edu.cn|g' uv.lock; \
    else \
        sed -i 's|pypi.tuna.tsinghua.edu.cn|pypi.org|g' uv.lock; \
    fi; \
    uv sync --python 3.12 --frozen && \
    .venv/bin/python3 -m ensurepip --upgrade

COPY web web
COPY docs/references docs/references
RUN --mount=type=cache,id=data-knowledge-api_npm,target=/root/.npm,sharing=locked \
    export NODE_OPTIONS="--max-old-space-size=4096" && \
    export VITE_NO_SOURCEMAP=1 && \
    export VITE_MINIFY=esbuild && \
    cd web && npm install && npm run build

COPY .git /data-knowledge-api/.git

RUN version_info=$(git describe --tags --match=v* --first-parent --always); \
    echo "data-knowledge-api version: $version_info"; \
    echo "$version_info" > /data-knowledge-api/VERSION

# -----------------------------------------------------------------------------
# production（不含 Node/Rust/编译头文件）
# -----------------------------------------------------------------------------
FROM base-runtime AS production
USER root

WORKDIR /data-knowledge-api

ENV VIRTUAL_ENV=/data-knowledge-api/.venv
COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

ENV PYTHONPATH=/data-knowledge-api/

COPY web web
COPY admin admin
COPY api api
COPY conf conf
COPY deepdoc deepdoc
COPY rag rag
COPY agent agent
COPY pyproject.toml uv.lock ./
COPY mcp mcp
COPY common common
COPY memory memory

RUN if [ -d bin ]; then \
        cp -r bin ./; \
        echo "✓ bin copied"; \
    else \
        echo "✗ bin ignored"; \
    fi

COPY docker /data-knowledge-api/docker
RUN cp /data-knowledge-api/docker/entrypoint.sh /data-knowledge-api/ && \
    chmod +x /data-knowledge-api/entrypoint*.sh && \
    cp /data-knowledge-api/docker/service_conf.yaml.template /data-knowledge-api/conf/service_conf.yaml.template && \
    cp /data-knowledge-api/docker/nginx/nginx.conf /etc/nginx/nginx.conf && \
    cp /data-knowledge-api/docker/nginx/data-knowledge-api.conf /etc/nginx/conf.d/data-knowledge-api.conf && \
    cp /data-knowledge-api/docker/nginx/proxy.conf /etc/nginx/proxy.conf && \
    rm -f /etc/nginx/conf.d/default.conf

COPY --from=builder /data-knowledge-api/web/dist /data-knowledge-api/web/dist
COPY --from=builder /data-knowledge-api/VERSION /data-knowledge-api/VERSION

# Promtail + 启动包装（Helm args 仍传给 entrypoint.sh）
ARG PROMTAIL_VERSION=3.2.1
RUN mkdir -p /data-knowledge-api/config /data-knowledge-api/logs && \
    arch="$(uname -m)"; \
    if [ "$arch" = "x86_64" ]; then PT_ARCH=amd64; elif [ "$arch" = "aarch64" ]; then PT_ARCH=arm64; else echo "unsupported arch: $arch"; exit 1; fi; \
    curl -fsSL -o /tmp/promtail.zip "https://productivity-console-prod-sh.oss-cn-shanghai.aliyuncs.com/promtail/v${PROMTAIL_VERSION}/promtail-linux-${PT_ARCH}-v${PROMTAIL_VERSION}.zip" && \
    unzip -q /tmp/promtail.zip -d /tmp/ && \
    mv "/tmp/promtail-linux-${PT_ARCH}" /usr/local/bin/promtail && \
    chmod +x /usr/local/bin/promtail && \
    rm -f /tmp/promtail.zip && rm -rf /tmp/promtail-*

COPY deployment/promtail-config-boe.yaml /data-knowledge-api/config/promtail-config-boe.yaml
COPY deployment/promtail-config-prod.yaml /data-knowledge-api/config/promtail-config-prod.yaml
COPY start.sh /data-knowledge-api/start.sh
RUN chmod +x /data-knowledge-api/start.sh

EXPOSE 9080
ENTRYPOINT ["/bin/bash", "/data-knowledge-api/start.sh"]
